{
    "all": true,
    "check-coverage": true,
    "exclude-after-remap": true,
    "extension": [".ts"],
    "src": ["source"],
    "exclude": [
        "**/*.entry-point.ts",
        "source/**/*.entry-point.ts",
        "source/**/*.test.ts",
        "source/**/*.type-test.ts",
        "source/**/*-types.ts",
        "tool-configurations/**",
        "target/**"
    ],
    "lines": 100,
    "functions": 100,
    "statements": 100,
    "branches": 100,
    "reporter": ["lcov", "text-summary"],
    "report-dir": "./target/coverage",
    "temp-directory": "./target/c8_output"
}
